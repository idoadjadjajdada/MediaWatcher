# Secrets
.env
.env.*
!.env.example

# Machine-local admin key: the launcher proves itself with this rather than
# being trusted for coming from loopback. Never commit it.
config/admin-key

# Dependencies
node_modules/

# User media and in-progress downloads
library/
temp/

# Generated seek-preview frames, keyed by file identity — always rebuildable
cache/

# SQLite database (and WAL sidecars)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Local reference notes; kept on disk, out of the repository
docs/claude info.md

# Brainstorming artifacts
.superpowers/

# Desktop build staging and Windows executables
.desktop-build/
dist/
test-results/
