# ---------------------------------------------------------------------------
# MediaWatcher configuration
# Copy this file to `.env` and fill in the two required keys.
# ---------------------------------------------------------------------------

# REQUIRED - app will not start without these
TMDB_API_KEY=                 # Get from themoviedb.org/settings/api
ALLDEBRID_API_KEY=            # Get from alldebrid.com/apikeys

# OPTIONAL - defaults shown
LIBRARY_PATH=./library        # Where your media files live
TEMP_PATH=./temp              # In-progress downloads
PORT=3000
TMDB_LANGUAGE=en-US
LOG_LEVEL=info                # error | warn | info | debug
SCAN_INTERVAL_MS=5000         # How often chokidar triggers rescan

# ---------------------------------------------------------------------------
# Search sources (all optional)
# ---------------------------------------------------------------------------

# Torrentio option segment. Generate it at https://torrentio.strem.fun/configure
# (tick the sites you want, then copy the segment out of the install URL).
# Example: providers=yts,eztv,1337x,thepiratebay,torrentgalaxy|sort=qualitysize
TORRENTIO_CONFIG=

# Jackett — run it locally, add whichever trackers you want there, and MediaWatcher
# queries them through one JSON API. Leave JACKETT_URL empty to disable this source.
JACKETT_URL=                  # e.g. http://127.0.0.1:9117
JACKETT_API_KEY=              # Jackett dashboard, top right
JACKETT_INDEXERS=all          # 'all' or a comma-separated list of indexer ids
JACKETT_TIMEOUT_MS=20000

SEARCH_SOURCE_TIMEOUT_MS=20000  # Per-source ceiling; a slow source is dropped, not fatal
SEARCH_MAX_RESULTS=60           # Results returned after ranking

# ---------------------------------------------------------------------------
# Playback (ffmpeg)
# ---------------------------------------------------------------------------
# Files the browser can already decode are streamed as raw bytes, untouched.
# Anything else is remuxed (container swap, no quality loss) or, only when the
# codec itself is undecodable, re-encoded. Install ffmpeg and leave these alone
# unless the binaries are not on your PATH.
FFMPEG_ENABLED=1
FFMPEG_PATH=ffmpeg            # or an absolute path to ffmpeg.exe
FFPROBE_PATH=ffprobe          # or an absolute path to ffprobe.exe
FFPROBE_TIMEOUT_MS=15000

TRANSCODE_AUDIO_BITRATE=192k  # Used only when source audio is DTS/TrueHD/etc
TRANSCODE_AUDIO_CHANNELS=2
TRANSCODE_VIDEO_PRESET=veryfast   # Video re-encode is a last resort
TRANSCODE_VIDEO_CRF=20
TRANSCODE_VIDEO_MAXRATE=12M
