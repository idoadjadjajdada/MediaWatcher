# Maintainer: MediaWatcher
#
# Build and install MediaWatcher on Arch:
#
#   cd packaging/arch && makepkg -si
#
# By default that packages the clone it is sitting in, at the commit currently
# checked out — a branch, a tag, whatever you cloned. Nothing has to be
# published for it to work, and the package you install is the code you are
# looking at.
#
# To package a different commit, tag or branch from the same clone:
#
#   _ref=some-branch makepkg -si
#
# To build from somewhere else entirely, clone it there and run this from that
# clone — there is nothing to configure, because this always packages the
# checkout it is inside.
#
# Or skip pacman entirely: `npm run dist:linux` builds the same application as
# an AppImage, a .pkg.tar.zst and a tarball in dist/.
#
# This builds the Electron shell, the backend and its Node runtime, and installs
# the lot under /opt/mediawatcher with a launcher, a desktop entry and icons.
# FFmpeg is a dependency rather than a bundled copy: Arch's ffmpeg is linked
# against the system's own libraries, so a copy of it inside the package would
# run on the machine that built it and nowhere else — and pacman is better at
# keeping FFmpeg current than this package would be.
#
# The build needs the network for npm packages, Electron and the Node license.
# It does not need, read or package anything from an existing .env, database or
# library: the staging step in tools/prepare-desktop.mjs copies an allowlist.

pkgname=mediawatcher
pkgver=1.5.0
pkgrel=1
pkgdesc='Self-hosted media library with TMDB metadata, a debrid downloader and a built-in player'
arch=('x86_64')
url='https://github.com/idoadjadjajdada/MediaWatcher'
license=('custom')
# What a machine needs to run this.
#
# Electron is bundled, so these are the system libraries Chromium links against
# rather than anything of MediaWatcher's own — every one of them verified to
# exist under this name in Arch's repositories. ffmpeg is the exception and the
# only one that is ours: the Linux build depends on the system copy instead of
# carrying one, because a distribution's ffmpeg is linked against a dozen of its
# own libraries and would not run anywhere else.
depends=(
  'ffmpeg'          # remuxing, transcoding, thumbnails, seek previews
  'gtk3'            # Electron's window toolkit, and most of Chromium's X deps
  'nss'             # TLS for the app's own requests to TMDB and AllDebrid
  'alsa-lib'        # audio output
  'libcups'         # Chromium links libcups.so.2 whether or not anything prints
  'mesa'            # libgbm, which Chromium's compositor needs even on software
  'libdrm'
  'libxtst'
  'libxss'
  'libnotify'       # download-finished notifications
  'at-spi2-core'    # accessibility bridge; Chromium fails to start without it
  'ttf-font'        # any font — without one every label renders as boxes
  # The tray, which is not a decoration here: closing the window keeps the
  # server running by default, and without an indicator library that leaves
  # somebody with a running library and no icon to click. An optional
  # dependency would not be installed, and this is small.
  'libayatana-appindicator'
)
# nodejs is only needed to build. The package carries its own copy of it for the
# backend, so nothing here is required at runtime.
makedepends=('git' 'nodejs>=20' 'npm' 'python' 'gcc' 'make')
optdepends=('tailscale: reach your library from outside the house')
# Electron and the bundled Node are prebuilt binaries; stripping them or
# hunting for their debug symbols achieves nothing and can break signatures.
options=('!strip' '!debug' '!lto')

# There is no source= line, and that is the point.
#
# This packages the checkout it is sitting in, and a git source cannot express
# that without going through machinery that has three ways to fail before it
# compiles a line: a ref that has to exist, a working copy makepkg has to be
# able to create, and a `git rev-parse` that quietly returns nothing when git
# distrusts the directory's ownership — each of which ends in "invalid
# reference" or "failure while creating working copy", about a tag that was
# never the point.
#
# prepare() exports the tree instead. The PKGBUILD's own location says where
# the repository is, so nothing has to be looked up, fetched, resolved or
# trusted, and the failure modes above cannot occur.
source=()
sha256sums=()

_srcdir="$pkgname"

# The tree to package. HEAD by default — the commit you have checked out — or
# any commit, tag or branch in this clone:  _ref=some-branch makepkg -si
# It has to be a tree that carries packaging/, since package() installs from it.
_ref="${_ref:-HEAD}"

prepare() {
  # ../.. from packaging/arch is the repository root, whatever it is called and
  # wherever it was cloned. No git query, so no ownership check to fail.
  local repo
  repo="$(cd "$startdir/../.." && pwd -P)"
  [ -f "$repo/package.json" ] || {
    printf 'This PKGBUILD builds the MediaWatcher checkout it lives in, and\n' >&2
    printf 'there is no package.json at %s.\n' "$repo" >&2
    printf 'Run it from packaging/arch inside a clone of the repository.\n' >&2
    return 1
  }

  rm -rf "$srcdir/$_srcdir"
  mkdir -p "$srcdir/$_srcdir"

  if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
    && git -C "$repo" archive --format=tar "$_ref" 2>/dev/null | tar -x -C "$srcdir/$_srcdir"; then
    # Tracked files at $_ref, which is also what leaves behind the .env, the
    # database, the library and node_modules: git archive carries none of them.
    msg2 "Packaging %s at %s" "$repo" "$(git -C "$repo" rev-parse --short "$_ref" 2>/dev/null || echo "$_ref")"
  else
    # No git, or a repository git will not read. Copy the tree instead, and
    # name everything that must not travel with it rather than hoping.
    msg2 "Packaging %s without git; excluding data, secrets and build output" "$repo"
    [ "$_ref" = HEAD ] || {
      printf '_ref=%s needs git to resolve, and git could not read %s.\n' "$_ref" "$repo" >&2
      return 1
    }
    tar -c -C "$repo" \
      --exclude=./.git --exclude=./node_modules --exclude=./dist \
      --exclude=./.desktop-build --exclude=./test-results \
      --exclude=./.env --exclude='./.env.*' --exclude=./config/admin-key \
      --exclude=./db/mediawatcher.db --exclude='./db/mediawatcher.db-*' \
      --exclude=./library --exclude=./temp --exclude=./cache \
      . | tar -x -C "$srcdir/$_srcdir"
  fi

  # Whatever route got us here, a secret must not be sitting in the build tree.
  rm -f "$srcdir/$_srcdir/.env" "$srcdir/$_srcdir/config/admin-key"
}

# No pkgver(): makepkg would rewrite this file mid-build to whatever the
# checkout says, which dirties the working tree it just packaged. The version
# lives in package.json, and tests/packaging.test.mjs fails if the two drift.

build() {
  cd "$srcdir/$_srcdir"
  # Keep every cache inside the build directory. makepkg is not the place to
  # write into somebody's home, and a shared Electron cache across versions is
  # the classic source of a package built from a stale download.
  export npm_config_cache="$srcdir/npm-cache"
  export ELECTRON_CACHE="$srcdir/electron-cache"
  export ELECTRON_BUILDER_CACHE="$srcdir/electron-builder-cache"

  # The native SQLite module has to build against the Node that Arch installs,
  # and Arch's Node is usually newer than any prebuild the package publishes.
  # When it is too new, `npm ci` fails a long way into the run with a wall of
  # C++ — so say what happened, once, in a sentence somebody can act on.
  if ! npm ci; then
    printf '\n' >&2
    printf 'better-sqlite3 could not be built against %s.\n' "$(node -v)" >&2
    printf 'Arch ships Node ahead of its prebuilds. Either wait for a\n' >&2
    printf 'better-sqlite3 release that supports it, or build with an older\n' >&2
    printf 'Node — nodejs-lts-jod, or a copy in your PATH for this build.\n' >&2
    return 1
  fi
  # Stages the backend, the shell, a copy of this machine's Node for the
  # backend's ABI, and — on Arch — a note that FFmpeg comes from the system.
  npm run desktop:prepare
  # --dir stops at the unpacked application. The packaging below is pacman's
  # job, and electron-builder's own pacman target would want fpm downloaded
  # halfway through a makepkg run.
  npx electron-builder --config electron-builder.cjs --linux --x64 --dir
}

package() {
  cd "$srcdir/$_srcdir"
  local unpacked="dist/linux-unpacked"

  install -dm755 "$pkgdir/opt/$pkgname"
  cp -a "$unpacked/." "$pkgdir/opt/$pkgname/"

  # Chromium's sandbox helper has to be setuid root, or every launch either
  # fails outright or falls back to running without a sandbox.
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  # The launcher, rather than a symlink: it is where MW_LINUX_PACKAGE is set, so
  # the app's updates window says "pacman" instead of guessing.
  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/$pkgname" <<'EOF'
#!/bin/sh
# MediaWatcher is installed by pacman, so the app checks for releases and then
# points at the package manager rather than replacing its own files.
MW_LINUX_PACKAGE=pacman
export MW_LINUX_PACKAGE
exec /opt/mediawatcher/mediawatcher "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/$pkgname"

  install -Dm644 packaging/linux/mediawatcher.desktop \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 packaging/linux/mediawatcher-server.service \
    "$pkgdir/usr/lib/systemd/user/$pkgname-server.service"

  install -Dm644 public/icons/icon-512.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 public/icons/icon-192.png \
    "$pkgdir/usr/share/pixmaps/$pkgname.png"

  # Electron's, Node's and Chromium's notices travel with the package.
  install -Dm644 "$unpacked/LICENSE.electron.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
  install -Dm644 "$unpacked/LICENSES.chromium.html" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
  install -Dm644 "$unpacked/resources/runtime/LICENSE.node.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.node.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/linux.md "$pkgdir/usr/share/doc/$pkgname/linux.md"
}
