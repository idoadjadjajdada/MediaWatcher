{
  "name": "mediawatcher",
  "version": "1.0.2",
  "private": true,
  "description": "Self-hosted media library with TMDB metadata enrichment, file organization and a built-in player.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/run.mjs",
    "ui-check": "node tests/ui-check.mjs",
    "ui-player": "node tests/ui-player.mjs",
    "ui-hls": "node tests/ui-hls.mjs",
    "ui-intro": "node tests/ui-intro.mjs",
    "ui-standalone": "node tests/ui-standalone.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:prepare": "node tools/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --win --x64 --dir",
    "dist": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --win --x64",
    "test:desktop": "node tests/desktop.test.mjs",
    "test:desktop-ui": "node tests/desktop-ui.mjs",
    "test:catalog": "node tests/catalog.test.mjs && node tests/catalog-ui.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "electron-updater": "6.8.9",
    "express": "^4.21.2",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  }
}
