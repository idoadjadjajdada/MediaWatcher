{
  "name": "MediaWatcher",
  "short_name": "MediaWatcher",
  "description": "Your own movie and TV library, wherever you are.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "categories": ["entertainment", "video"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Continue watching", "url": "/#home", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shows", "url": "/#shows", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Downloads", "url": "/#downloads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
